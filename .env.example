# Порты локальной проверки
API_PORT=8080
MINI_APP_PORT=5173

# Локальный пароль PostgreSQL: замените значение в реальном .env.
POSTGRES_PASSWORD=replace_with_local_password

# Адрес API, доступный из браузера, где открыто мини-приложение.
VITE_API_BASE_URL=http://localhost:8080
MINI_APP_URL=http://localhost:5173

# Настройки MAX. Не добавляйте рабочий токен в репозиторий.
MAX_BOT_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_API_TOKEN=
# Только [A-Za-z0-9_-], 5–256 символов.
MAX_WEBHOOK_SECRET=replace-with-webhook-secret
# Публичный HTTPS-адрес webhook (порт 443). Пусто = подписка не создаётся.
MAX_WEBHOOK_URL=
# link | open_app (open_app — только если мини-приложение привязано к боту в кабинете MAX)
MINI_APP_BUTTON=link
CORS_ORIGINS=http://localhost:5173

# Интервал фоновых задач (напоминания, «Как прошло?») в секундах.
NOTIFIER_INTERVAL_SECONDS=60

# dev — мини-приложение можно открыть в обычном браузере без подписи MAX;
# prod — только подписанные данные запуска MAX (initData).
APP_ENV=dev
# on — показывать демо-партнёров с онлайн-записью (помечены как модельные данные).
DEMO_DATA=on
# Код входа в режим администратора студии. Придумайте свой, не коммитьте.
PARTNER_DEMO_CODE=
# Тестовые учётные записи, которым разрешён заголовок X-MAX-User-ID.
TEST_MAX_USER_IDS=max-test-user-001

# Только для APP_ENV=dev: от чьего имени мини-приложение работает в браузере.
VITE_DEV_MAX_USER_ID=max-test-user-001
