# Порты локальной проверки
API_PORT=8080
MINI_APP_PORT=5173

# Локальный пароль PostgreSQL: замените значение в реальном .env.
POSTGRES_PASSWORD=replace_with_local_password

# Адрес API, доступный из браузера, где открыто мини-приложение.
VITE_API_BASE_URL=http://localhost:8080
MINI_APP_URL=http://localhost:5173

# Настройки MAX. Не добавляйте рабочий токен в репозиторий.
MAX_BOT_API_BASE_URL=https://botapi.max.ru
MAX_BOT_API_TOKEN=
MAX_WEBHOOK_SECRET=replace_with_webhook_secret
CORS_ORIGINS=http://localhost:5173

# Интервал проверки напоминаний в секундах.
NOTIFIER_INTERVAL_SECONDS=120

# Только для локального запуска приложения в браузере вне MAX.
VITE_DEMO_MAX_USER_ID=max-test-user-001
