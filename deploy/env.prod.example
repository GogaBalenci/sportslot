# Скопируйте на сервере:  cp deploy/env.prod.example .env  и заполните.
# Файл .env не коммитится (есть в .gitignore).

# Домен, A-запись которого указывает на IP сервера. Порты 80 и 443 должны быть свободны.
DOMAIN=sportslot.example.ru

# API и мини-приложение наружу не публикуем — трафик идёт через Caddy.
API_PORT=127.0.0.1:8080
MINI_APP_PORT=127.0.0.1:5173

# Сгенерируйте: openssl rand -hex 16
POSTGRES_PASSWORD=
# Только [A-Za-z0-9_-], 5–256 символов. Сгенерируйте: openssl rand -hex 24
MAX_WEBHOOK_SECRET=

# Токен бота из кабинета MAX для бизнеса. Никогда не коммитьте его.
MAX_BOT_API_TOKEN=
MAX_BOT_API_BASE_URL=https://platform-api2.max.ru

NOTIFIER_INTERVAL_SECONDS=60

# open_app — мини-приложение открывается внутри MAX (оно привязано к боту).
# link — запасной вариант: обычная ссылка на https://<DOMAIN>/.
MINI_APP_BUTTON=open_app

# Демо-партнёры с онлайн-записью (помечены как модельные данные). off — только реальный каталог.
DEMO_DATA=on
# Код входа в режим администратора студии для жюри. Сгенерируйте: openssl rand -hex 4
PARTNER_DEMO_CODE=
# Тестовые учётные записи для проверок DATA-API (заголовок X-MAX-User-ID).
TEST_MAX_USER_IDS=max-test-user-001

# Ключ «JavaScript API и HTTP Геокодер» Яндекс Карт для карты в мини-приложении.
# Пусто — используется запасная карта. Ключ попадает в сборку фронтенда, ограничьте его по домену.
VITE_YANDEX_MAPS_API_KEY=
