# Скопируйте на сервере:  cp deploy/env.prod.example .env  и заполните.
# Файл .env не коммитится (есть в .gitignore).

# Домен, A-запись которого указывает на IP сервера. Порты 80 и 443 должны быть свободны.
DOMAIN=sportslot.example.ru

# API и мини-приложение наружу не публикуем — трафик идёт через Caddy.
API_PORT=127.0.0.1:8080
MINI_APP_PORT=127.0.0.1:5173

# Сгенерируйте: openssl rand -hex 16
POSTGRES_PASSWORD=
# Только [A-Za-z0-9_-], 5–256 символов. Сгенерируйте: openssl rand -hex 24
MAX_WEBHOOK_SECRET=

# Токен бота из кабинета MAX для бизнеса. Никогда не коммитьте его.
MAX_BOT_API_TOKEN=
MAX_BOT_API_BASE_URL=https://platform-api2.max.ru

NOTIFIER_INTERVAL_SECONDS=60

# link — кнопка-ссылка на мини-приложение (работает с одним токеном).
# open_app — открытие внутри MAX; включайте, только когда организаторы привяжут
# https://<DOMAIN>/ как мини-приложение бота в кабинете платформы MAX.
MINI_APP_BUTTON=link
